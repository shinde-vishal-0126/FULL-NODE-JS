{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Target Environment */
    "target": "ES2022", // Target modern JavaScript features
    "module": "NodeNext", // Required for modern Node.js (ESM / CommonJS hybrid)
    "moduleResolution": "NodeNext", // Tells TypeScript how to look up modules
    /* Build Artifacts */
    "rootDir": "./src", // Where your TypeScript source files live
    "outDir": "./dist", // Where compiled JavaScript output goes
    "sourceMap": true, // Helps with debugging compiled code
    "declaration": true, // Generates corresponding '.d.ts' files
    /* Strict Type-Checking */
    "strict": true, // Enables all strict type-checking options
    "noUnusedLocals": true, // Reports errors on unused local variables
    "noUnusedParameters": true, // Reports errors on unused function parameters
    "noImplicitReturns": true, // Ensures all code paths in a function return a value
    "noFallthroughCasesInSwitch": true, // Reports errors for fallthrough cases in switch statements
    /* Interoperability & Optimization */
    "esModuleInterop": true, // Ensures compatibility with CommonJS modules
    "skipLibCheck": true, // Skips type checking of all declaration files (*.d.ts)
    "forceConsistentCasingInFileNames": true // Disallows inconsistently-cased references to the same file
  },
  "include": [
    "src/**/*"
  ], // Compile everything inside the src folder
  "exclude": [
    "node_modules",
    "dist"
  ] // Ignore dependencies and build outputs
}